\name{rbrob}
\alias{rbrob}
\alias{rbrobb}
\title{Random brobs}
\description{Creates a vector of random brobs.  Intended as
  quick \dQuote{get you going} examples}
\usage{
rbrob(n = 10)
rbrobb(n = 30)
}
\arguments{
  \item{n}{Length of random vector to generate}
}
\details{

Functions \code{rbrobb()} gives, by default, a more complicated
expression.

}
\author{Robin K. S. Hankin}
\examples{

rbrob()
rbrobb()

}
